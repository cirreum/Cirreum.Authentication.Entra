<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>Cirreum.Authentication.Entra</AssemblyName>
		<RootNamespace>Cirreum.Authentication</RootNamespace>
		<Description>Azure Entra ID authentication scheme for the Cirreum framework. Wraps Microsoft.Identity.Web for Entra-issued JWT validation (Web API) and OpenID Connect (Web App).</Description>
		<PackageTags>cirreum;authentication;entra;azuread;jwt;openidconnect</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<!-- Cirreum.Providers (+ Kernel/Contracts/Result) flow in transitively via Cirreum.AuthenticationProvider. -->
		<PackageReference Include="Cirreum.AuthenticationProvider" Version="3.2.0" />

		<PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />

		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Cirreum.Providers" />
	</ItemGroup>

	<!-- InternalsVisibleTo: Local Development Only -->
	<ItemGroup Label="InternalsVisibleTo" Condition="'$(IsLocalBuild)' == 'true'">
		<InternalsVisibleTo Include="Cirreum.Authentication.Entra.Tests" />
	</ItemGroup>

</Project>
